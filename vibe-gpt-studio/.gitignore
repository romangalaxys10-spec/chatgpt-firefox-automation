sessions/
*.db
*.sqlite
*.sqlite-journal
/tmp/
*.log

# Env & secrets
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Python (automation submodule)
__pycache__/
*.pyc
*.egg-info/
*.backup
